{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      "$productId": {
        ".write": "auth != null && root.child('settings/adminUid').val() === auth.uid",
        ".validate": "newData.hasChildren(['name', 'price', 'categoryId', 'stock'])",
        "stock": {
          ".write": "auth != null && newData.isNumber() && newData.val() >= 0",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "categoryId": {
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "sizes": {
          ".validate": "newData.hasChildren()"
        }
      }
    },

    "categories": {
      ".read": true,
      ".write": "auth != null && root.child('settings/adminUid').val() === auth.uid",
      "$categoryId": {
        ".validate": "newData.hasChildren(['name'])"
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('settings/adminUid').val() === auth.uid"
    },

    "users": {
      ".read": "auth != null && root.child('settings/adminUid').val() === auth.uid",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('settings/adminUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid', 'fullName', 'email', 'phone', 'status', 'createdAt', 'updatedAt']) && newData.child('uid').val() === $uid",
        "uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.val() === $uid"
        },
        "fullName": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length > 0"
        },
        "email": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.isString() && newData.val().length > 3"
        },
        "phone": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length >= 7"
        },
        "address": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },
        "barangay": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },
        "city": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },
        "province": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },
        "postalCode": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },
        "profileImage": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        },
        "status": {
          ".write": "(auth != null && auth.uid === $uid && !data.exists()) || (auth != null && root.child('settings/adminUid').val() === auth.uid)",
          ".validate": "newData.val() === 'active' || newData.val() === 'disabled'"
        },
        "createdAt": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        },
        "lastLoginAt": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "wishlist": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$productId": {
          ".validate": "newData.hasChildren(['productId', 'addedAt']) && newData.child('productId').val() === $productId"
        }
      }
    },

    "cart": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$lineId": {
          ".validate": "newData.hasChildren(['productId', 'quantity', 'size']) && newData.child('quantity').isNumber() && newData.child('quantity').val() > 0 && newData.child('quantity').val() <= 99"
        }
      }
    },

    "orders": {
      ".read": "auth != null && root.child('settings/adminUid').val() === auth.uid",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('settings/adminUid').val() === auth.uid)",
        "$orderId": {
          ".write": "(auth != null && auth.uid === $uid && !data.exists()) || (auth != null && root.child('settings/adminUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['orderNumber', 'userId', 'items', 'subtotal', 'shippingFee', 'totalAmount', 'deliveryAddress', 'paymentMethod', 'paymentStatus', 'orderStatus', 'createdAt', 'updatedAt']) && newData.child('userId').val() === $uid",
          "orderNumber": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "userId": {
            ".validate": "newData.val() === $uid"
          },
          "items": {
            ".validate": "newData.hasChildren()",
            "$index": {
              ".validate": "newData.hasChildren(['productId', 'name', 'imageUrl', 'price', 'quantity', 'size']) && newData.child('quantity').isNumber() && newData.child('quantity').val() > 0 && newData.child('price').isNumber() && newData.child('price').val() === root.child('products').child(newData.child('productId').val()).child('price').val()"
            }
          },
          "subtotal": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "shippingFee": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "totalAmount": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "deliveryAddress": {
            ".validate": "newData.hasChildren(['fullName', 'phone', 'email', 'street', 'city', 'province', 'postalCode'])"
          },
          "paymentMethod": {
            ".validate": "newData.val() === 'cod' || newData.val() === 'gcash' || newData.val() === 'maya' || newData.val() === 'card'"
          },
          "paymentStatus": {
            ".write": "(auth != null && auth.uid === $uid && data.exists() && newData.val() === 'cancelled' && data.val() === 'pending') || (auth != null && root.child('settings/adminUid').val() === auth.uid)",
            ".validate": "newData.val() === 'pending' || newData.val() === 'paid_simulated' || newData.val() === 'failed_simulated' || newData.val() === 'refunded_simulated' || newData.val() === 'cancelled' || newData.val() === 'paid' || newData.val() === 'failed' || newData.val() === 'refunded'"
          },
          "orderStatus": {
            ".write": "(auth != null && auth.uid === $uid && data.exists() && newData.val() === 'cancelled' && (data.val() === 'pending' || data.val() === 'confirmed')) || (auth != null && root.child('settings/adminUid').val() === auth.uid)",
            ".validate": "newData.val() === 'pending' || newData.val() === 'confirmed' || newData.val() === 'processing' || newData.val() === 'shipped' || newData.val() === 'delivered' || newData.val() === 'cancelled'"
          },
          "updatedAt": {
            ".write": "(auth != null && auth.uid === $uid && data.exists()) || (auth != null && root.child('settings/adminUid').val() === auth.uid)",
            ".validate": "newData.isNumber()"
          },
          "statusHistory": {
            ".write": "(auth != null && auth.uid === $uid && data.exists()) || (auth != null && root.child('settings/adminUid').val() === auth.uid)",
            ".validate": "newData.hasChildren()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    },

    "payments": {
      ".read": "auth != null && root.child('settings/adminUid').val() === auth.uid",
      "$paymentId": {
        ".read": "auth != null && (data.child('userId').val() === auth.uid || root.child('settings/adminUid').val() === auth.uid)",
        ".write": "auth != null && (root.child('settings/adminUid').val() === auth.uid || (!data.exists() && newData.child('userId').val() === auth.uid && newData.child('paymentMethod').val() === 'cod' && newData.child('paymentStatus').val() === 'pending'))",
        ".validate": "newData.hasChildren(['userId', 'orderId', 'amount', 'paymentMethod', 'paymentStatus', 'createdAt', 'updatedAt']) && newData.child('amount').isNumber() && newData.child('amount').val() >= 0",
        "userId": {
          ".validate": "newData.val() === auth.uid"
        },
        "amount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "paymentMethod": {
          ".validate": "newData.val() === 'cod' || newData.val() === 'gcash' || newData.val() === 'maya' || newData.val() === 'card'"
        },
        "paymentStatus": {
          ".write": "(auth != null && root.child('payments').child($paymentId).child('userId').val() === auth.uid && root.child('payments').child($paymentId).child('paymentStatus').val() === 'pending' && newData.val() === 'cancelled') || (auth != null && root.child('settings/adminUid').val() === auth.uid)",
          ".validate": "newData.val() === 'pending' || newData.val() === 'paid_simulated' || newData.val() === 'failed_simulated' || newData.val() === 'refunded_simulated' || newData.val() === 'cancelled' || newData.val() === 'paid' || newData.val() === 'failed' || newData.val() === 'refunded'"
        },
        "updatedAt": {
          ".write": "(auth != null && root.child('payments').child($paymentId).child('userId').val() === auth.uid) || (auth != null && root.child('settings/adminUid').val() === auth.uid)",
          ".validate": "newData.isNumber()"
        }
      }
    },

    "orderLocks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$orderId": {
          ".validate": "newData.hasChildren(['orderId', 'createdAt'])"
        }
      }
    }
  }
}